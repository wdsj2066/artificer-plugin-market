{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/wdsj2066/artificer-plugin-market/main/schema/registry.schema.json",
  "title": "Artificer Plugin Registry",
  "type": "object",
  "required": ["registryVersion", "plugins"],
  "properties": {
    "registryVersion": { "type": "integer", "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "plugins": { "type": "array", "items": { "$ref": "#/definitions/plugin" } }
  },
  "definitions": {
    "plugin": {
      "type": "object",
      "required": ["id", "name", "version", "description", "author", "downloadUrl", "sha256", "engines"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,63}$" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$" },
        "description": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "icon": { "type": "string" },
        "repositoryUrl": { "type": "string", "format": "uri" },
        "releaseUrl": { "type": "string", "format": "uri" },
        "downloadUrl": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "engines": { "type": "object", "required": ["artificer"], "properties": { "artificer": { "type": "string", "minLength": 1 } }, "additionalProperties": false },
        "permissions": { "type": "array", "items": { "enum": ["llm", "filesystem", "network", "subprocess", "routes", "channels", "hooks", "mcp", "settings"] }, "uniqueItems": true },
        "hasBackend": { "type": "boolean" },
        "screenshots": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "featured": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}